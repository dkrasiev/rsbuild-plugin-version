{
  "name": "rsbuild-plugin-version",
  "version": "0.1.0",
  "description": "Rsbuild plugin that emits version.json with git commit, branch, and date info.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "rsbuild",
    "rsbuild-plugin",
    "version",
    "git"
  ],
  "license": "MIT"
}
