{
  "name": "rsbuild-plugin-version",
  "version": "1.0.0-next.1",
  "description": "Rsbuild plugin that emits version.json with git commit, branch, and date info.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Dmitry Krasiev <dmitrykrasiev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkrasiev/rsbuild-plugin-version.git"
  },
  "bugs": {
    "url": "https://github.com/dkrasiev/rsbuild-plugin-version/issues"
  },
  "homepage": "https://github.com/dkrasiev/rsbuild-plugin-version#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^20.0.0",
    "semantic-release": "^25.0.5",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "rsbuild",
    "rsbuild-plugin",
    "version",
    "git"
  ],
  "license": "MIT"
}
